# Copy this file to `.env` (which is git-ignored) and fill in your real key.
# NEVER commit .env, and never paste your key into chat/logs. Rotate if exposed.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: real-time email alerts. Without these, alerts print to the console.
# Use a Gmail App Password (not your account password): https://myaccount.google.com/apppasswords
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
